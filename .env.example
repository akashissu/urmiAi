# Copy this file to .env and fill LLM_API_KEY.
# .env is gitignored. Every value below is a local placeholder.
#
# Kubernetes does not read this file. The chart builds Secrets from
# helm/urmiai/charts/*/values.yaml and helm/urmiai/values-local.yaml.
# After you set LLM_API_KEY, push it into the cluster with the command
# in docs/HOW_TO_TEST.md (section "Turn chat on").

# --- Gateway (Secret gateway-config). Required. No defaults. ---
# Postgres URL the gateway process uses. The postgres container itself
# uses POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgres://gateway:changeme-local-only@postgres:5432/gateway
# Base64 of exactly 32 bytes. This local value is 32 zero bytes.
# A real one is: openssl rand -base64 32
GATEWAY_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Signs the dashboard session cookie-equivalent JWT. 12 hours.
JWT_SECRET=changeme-local-only
# Key from https://platform.openai.com/api-keys (starts with sk-).
# Chat returns "LLM_API_KEY is not configured" while this is empty.
LLM_API_KEY=

# --- Gateway (plain env on the Deployment, not the Secret) ---
# Same /chat/completions shape. Gemini: generativelanguage.googleapis.com/v1beta/openai
# and gemini-3.1-flash-lite. Groq: https://api.groq.com/openai/v1 and llama-3.3-70b-versatile.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# true only for kind. Production values set this false.
ALLOW_INTERNAL_UPSTREAMS=true

# --- Gateway defaults. The chart does not set these. ---
PORT=8080
UPSTREAM_TIMEOUT_MS=15000
HEALTH_CHECK_INTERVAL_MS=15000

# --- Gateway Postgres container (Secret gateway-db) ---
POSTGRES_USER=gateway
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=gateway

# --- WooCommerce MCP server ---
# ClusterIP only. The browser never calls this.
WC_BASE_URL=http://wordpress
# Generated by the wp-init job into /var/www/html/.urmiai-wc-key.
# Do not paste a key here. WooCommerce stores only an HMAC of it.
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Notes MCP server ---
# PORT=8080 is the only env it reads. Notes are in memory.

# --- WordPress (Secret wordpress-db) ---
WORDPRESS_DB_HOST=mariadb
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=changeme-local-only
# Used by the init job only, to create the WP admin user.
WP_URL=http://store.urmiai.local
WP_ADMIN_PASSWORD=changeme-local-only

# --- MariaDB (Secret mariadb-credentials) ---
MARIADB_ROOT_PASSWORD=changeme-local-only
MARIADB_DATABASE=wordpress
MARIADB_USER=wordpress
MARIADB_PASSWORD=changeme-local-only

# --- Dashboard ---
# The built image has no env vars. nginx proxies /api and /mcp to the gateway.
# Open http://127.0.0.1:18080 or http://app.urmiai.local
